# Copy to .env for local runs. On Render, set these in the service's Environment tab.

# Server (Render injects PORT automatically; HOST must stay 0.0.0.0 in containers)
PORT=5000
HOST=0.0.0.0

# Local Whisper model: base.en (default, English), tiny.en (lighter), base / small (multilingual)
WHISPER_MODEL=base.en
# Optional override of Whisper CPU threads (defaults to the container's CPU quota)
# WHISPER_THREADS=2

# Delete uploads/exports older than this many hours
FILE_TTL_HOURS=12

# Optional AI providers (all optional; everything also runs locally)
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Optional YouTube cookies (base64 of a Netscape cookies.txt) for URL imports from cloud servers
YOUTUBE_COOKIES_BASE64=

# Optional explicit tool paths (the Docker image sets these)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YTDLP_PATH=/opt/venv/bin/yt-dlp
# PYTHON_BIN=/opt/venv/bin/python3
