# Keep the Docker build context small and reproducible
.git
.github
**/node_modules
client/dist
client/.vite
**/.DS_Store
**/__pycache__
**/*.pyc
.venv
venv

# Local secrets / state never go into the image
.env
.env.*
!.env.example
server/yt-cookies.txt

# Runtime data folders (created fresh inside the container)
server/uploads
server/exports
server/samples

# Test artifacts and logs
test_*.mp4
test_*.wav
test_*.jpg
frame_*.jpg
*.log
npm-debug.log*

# Not needed in the image
docker-compose.yml
deno.lock
